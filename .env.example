# Environment configuration for Air Quality Monitoring Agent
# Copy this file to .env and configure as needed

# API Configuration
OPENAQ_API_KEY=your_openaq_api_key_here
TEMPO_API_KEY=your_nasa_earthdata_api_key_here

# Location Detection
DEFAULT_LOCATION_LAT=40.7128
DEFAULT_LOCATION_LON=-74.0060
IP_GEOLOCATION_API=http://ip-api.com/json

# Request Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Data Source Settings
ENABLE_OPENAQ=true
ENABLE_TEMPO=true
MAX_STATION_DISTANCE_KM=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=aqi_agent.log

# Web Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG_MODE=false